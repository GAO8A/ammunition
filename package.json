{
  "name": "ammunition",
  "version": "1.0.0-alpha.0",
  "description": "SAAMI cartridge and shotshell dimensions, and SVG drawings generated from them",
  "license": "MIT",
  "author": "Rick Gao",
  "repository": "github:GAO8A/ammunition",
  "bugs": { "url": "https://github.com/GAO8A/ammunition/issues" },
  "homepage": "https://github.com/GAO8A/ammunition#readme",
  "keywords": ["ammunition", "cartridges", "ammo", "saami", "bullets", "svg"],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./data": { "types": "./dist/data/index.d.ts", "default": "./dist/data/index.js" }
  },
  "files": ["dist", "data"],
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "build": "npm run data && tsc",
    "test": "npm run build && node --test test/render.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  },
  "engines": { "node": ">=18" }
}
